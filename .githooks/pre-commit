#!/usr/bin/env python3
"""Pre-commit hook enforcing isui.ren-Bahnhof repo rules.

Rules:
  1. No Chinese characters anywhere in tracked text files.
  2. Emoji are allowed but should be used sparingly (warning only).
"""

import re
import subprocess
import sys

# Han (Chinese) characters: CJK Unified Ideographs + Extension A + Compatibility
CJK_RE = re.compile(r"[\u3400-\u4DBF\u4E00-\u9FFF\uF900-\uFAFF]")

# Common emoji ranges: dingbats, emoticons, misc symbols, misc pictographs,
# supplemental symbols/pictographs, variation selector (ZWJ-sequences include U+FE0F)
# NOTE: astral-plane ranges need \U (8 hex digits), not \u (4 hex digits).
EMOJI_RE = re.compile(r"[\u2600-\u27BF\u2B00-\u2BFF\U0001F000-\U0001FAFF\uFE0F]")

EMOJI_WARN_THRESHOLD = 3


def staged_files():
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "-z"],
        capture_output=True, check=True,
    ).stdout
    return [p for p in out.decode("utf-8", "replace").split("\0") if p]


def main():
    violations = []
    warnings = []

    for path in staged_files():
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as fh:
                text = fh.read()
        except OSError:
            continue  # unreadable (deleted etc.): skip

        for m in CJK_RE.finditer(text):
            line = text.count("\n", 0, m.start()) + 1
            violations.append(f"  {path}:{line}")

        emoji_count = len(EMOJI_RE.findall(text))
        if emoji_count > EMOJI_WARN_THRESHOLD:
            warnings.append(
                f"  {path}: {emoji_count} emoji (keep it sparse)"
            )

    for w in warnings:
        print(f"warn:{w}", file=sys.stderr)

    if violations:
        print("error: Chinese characters are not allowed in this repo:", file=sys.stderr)
        for v in violations:
            print(v, file=sys.stderr)
        print("Remove the Chinese text and re-stage the files.", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
